{
  "name": "kimia-snbt-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kimia-lisensi",
      "database_id": "69e3b92a-89af-4d16-8ee6-3d201722ad09"
    }
  ],
  // Soal premium disimpan sebagai aset privat: tidak pernah dilayani langsung
  // ke publik, hanya lewat Worker setelah token divalidasi.
  "assets": {
    "directory": "./premium",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://kimia.ajarkita.my.id,https://rezi-d.github.io,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500"
  }
}
